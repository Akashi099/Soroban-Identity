<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for credential exports produced by the SDK (#939, `credentialToXml`).

  A document is valid when it has the root element below with
  `schemaVersion="1"`: the element order is the order the serialiser emits, and
  optional elements are omitted rather than written empty (so `expiresAt` is
  simply absent for a credential that never expires, instead of `null`).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://soroban-identity.dev/schema/credential-export"
           xmlns="https://soroban-identity.dev/schema/credential-export"
           elementFormDefault="qualified">

  <xs:element name="credential">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:string"/>
        <xs:element name="subject" type="xs:string"/>
        <xs:element name="issuer" type="xs:string"/>
        <xs:element name="credentialType" type="xs:string"/>
        <xs:element name="status">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="valid"/>
              <xs:enumeration value="revoked"/>
              <xs:enumeration value="expired"/>
              <xs:enumeration value="not-yet-active"/>
              <xs:enumeration value="cancelled"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="claims">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="claim" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="name" type="xs:string" use="required"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="claimsHash" type="xs:string"/>
        <xs:element name="signature" type="xs:string"/>
        <xs:element name="version" type="xs:nonNegativeInteger"/>
        <xs:element name="revoked" type="xs:boolean"/>
        <xs:element name="revokedAt" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="issuedAt" type="xs:dateTime"/>
        <xs:element name="expiresAt" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="activationTime" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="exportedAt" type="xs:dateTime"/>
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:positiveInteger" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
