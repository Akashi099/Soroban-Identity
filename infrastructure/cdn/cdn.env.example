# Copy to cdn.env (git-ignored) and fill in; every script in scripts/ sources it.
# In CI these come from the deploy workflow's environment instead.

FRONTEND_URL=https://app.example.com

# Needed by purge-cache.sh and metrics.sh
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=          # Cache Purge + Analytics:Read on the zone

# Optional: Globalping token for higher multi-region test limits
# GLOBALPING_TOKEN=
