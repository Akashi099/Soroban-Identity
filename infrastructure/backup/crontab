# Automated database backups (INFRA-01 / issue #862)
# Install with: crontab infrastructure/backup/crontab
#
# Runs the backup script daily at 02:00 UTC.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# m  h  dom mon dow   command
  0  2   *   *   *    /usr/local/bin/backup.sh >> /var/log/db-backup.log 2>&1
