{
  "name": "soroban-identity-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run images:webp && tsc && vite build && npm run assets:compress && npm run bundle:budget",
    "preview": "vite preview",
    "analyze": "vite build && node scripts/analyze-bundle.mjs",
    "images:webp": "node scripts/convert-images-to-webp.mjs",
    "assets:compress": "node scripts/compress-assets.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "test:jest": "jest",
    "test:update": "jest -u",
    "validate:locales": "node scripts/validate-locales.js",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^0.9.2",
    "@soroban-identity/sdk": "^0.1.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "@walletconnect/sign-client": "^2.17.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.0.7",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^17.0.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "react-test-renderer": "^18.3.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0",
    "vitest-axe": "^0.1.0"
  }
}
