{
  "name": "@soroban-identity/cli",
  "version": "0.1.0",
  "description": "Command-line tool for managing Soroban Identity DIDs and verifiable credentials",
  "license": "MIT",
  "bin": {
    "soroban-id": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "soroban",
    "stellar",
    "did",
    "verifiable-credentials",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/El-Chapo-Npm/Soroban-Identity.git",
    "directory": "cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "@soroban-identity/sdk": "^0.1.0",
    "@stellar/stellar-sdk": "~12.0.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "typescript": "^5.4.0"
  }
}
