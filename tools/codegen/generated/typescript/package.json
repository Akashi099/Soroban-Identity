{
  "name": "@soroban-identity/client-ts",
  "version": "0.1.0",
  "description": "Generated TypeScript API client for the Soroban Identity Server API (typescript-fetch).",
  "author": "Soroban Identity",
  "repository": {
    "type": "git",
    "url": "https://github.com/El-Chapo-Npm/Soroban-Identity.git"
  },
  "keywords": [
    "fetch",
    "typescript",
    "openapi-client",
    "openapi-generator"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "typings": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build"
  },
  "dependencies": {
    "whatwg-fetch": "^3.0.0",
    "es6-promise": "^4.2.4"
  },
  "devDependencies": {
    "typescript": "^5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
