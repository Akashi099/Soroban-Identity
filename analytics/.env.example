# Soroban RPC endpoint and network
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed contract IDs (from scripts/deploy.sh)
IDENTITY_REGISTRY_ID=
CREDENTIAL_MANAGER_ID=

# First ledger to index. Defaults to LOOKBACK_LEDGERS before the latest ledger.
# START_LEDGER=
LOOKBACK_LEDGERS=17280

# Polling interval for new events (ms)
POLL_INTERVAL_MS=5000

# Scan all network transactions for verify_credential calls (heavier on mainnet)
TRACK_VERIFICATION_TXS=true

# Look up the optional `country` metadata key on each DID for the geo view
RESOLVE_DID_COUNTRY=true

# HTTP server
PORT=8790
DATA_FILE=./data/analytics.json

# Shared secret required by POST /api/verifications (leave empty to disable reporting)
REPORT_TOKEN=
